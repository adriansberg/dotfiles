#!/bin/sh
# GNOME's window manager component for the "i3-gnome" session.
# From github.com/mbaynton/i3-gnome (MIT, see LICENSE), changed to start i3
# with this session's own config instead of the plain i3 one.

# Register with gnome-session so that it does not kill the whole session thinking it is dead.
if [ -n "$DESKTOP_AUTOSTART_ID" ]; then
    dbus-send --print-reply --session --dest=org.gnome.SessionManager "/org/gnome/SessionManager" org.gnome.SessionManager.RegisterClient "string:i3-gnome" "string:$DESKTOP_AUTOSTART_ID"
fi

i3 -c "$HOME/.config/i3/gnome"

# Close the session when i3 exits.
if [ -n "$DESKTOP_AUTOSTART_ID" ]; then
    dbus-send --print-reply --session --dest=org.gnome.SessionManager "/org/gnome/SessionManager" org.gnome.SessionManager.Logout "uint32:1"
fi
