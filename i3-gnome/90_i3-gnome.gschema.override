# GNOME defaults for the "i3-gnome" session only (the name after the colon is
# matched against XDG_CURRENT_DESKTOP). Each one keeps a GNOME part from
# getting in the way of i3; everything else GNOME does is left on.

# GNOME locks the screen on Win+L, which is "focus right" in i3/flow. Move the
# lock to Win+Escape, where the other sessions have it.
[org.gnome.settings-daemon.plugins.media-keys:i3-gnome]
screensaver=['<Super>Escape']

# Flashback's desktop is a window, and i3 would tile it like an app. Draw the
# wallpaper on the root window instead.
[org.gnome.gnome-flashback:i3-gnome]
desktop=false
root-background=true

# Print and Shift+Print belong to Flameshot (i3/gnome). Flashback keeps its
# other screenshot keys and its screen recorder on Ctrl+Shift+Alt+R.
[org.gnome.gnome-flashback.keybindings:i3-gnome]
screenshot=@as []
area-screenshot=@as []

# GNOME switches keyboard layouts on Win+Space, which opens the launcher here.
[org.gnome.desktop.wm.keybindings:i3-gnome]
switch-input-source=@as []
switch-input-source-backward=@as []
