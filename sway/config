# Sway session ("Sway" on the login screen). Goes in ~/.config/sway/config.
# Check it on the machine with: sway -C -c ~/.config/sway/config
#
# The shortcuts live in sway/flow. This file adds what a bare Wayland session
# lacks and a full desktop would provide: keyboard, touchpad, bar, lock,
# function keys and tray.
# Sway only allows comments on their own line, never after a command.

# The Windows key. On an Apple keyboard, use Mod1 to stay on Option.
set $mod Mod4

font pango:FiraCode Nerd Font 10

# A thin border instead of a title bar on every window.
default_border pixel 2
default_floating_border pixel 2

include ~/.config/sway/flow

# Exports WAYLAND_DISPLAY and friends to systemd and D-Bus, so dunst, the
# portals (screen sharing) and other activated services find the session.
include /etc/sway/config.d/*
# That file leaves out the desktop name, which the portals need to pick their
# Sway backends (/usr/share/xdg-desktop-portal/sway-portals.conf).
exec dbus-update-activation-environment --systemd XDG_CURRENT_DESKTOP

# Ctrl+Q quits the focused app, like Cmd+Q on the Mac: it closes every window
# with the same app_id (Wayland) or class (XWayland). Apps can still ask about
# unsaved work. Sway takes the key, so apps no longer see Ctrl+Q themselves.
# The shell guards matter: __focused__ also matches an empty value, so without
# them a Wayland app would close every XWayland window, and the other way round.
bindsym Ctrl+q [app_id="__focused__" shell="xdg_shell"] kill; [class="__focused__" shell="xwayland"] kill

# ---------------------------------------------------------------------------
# Input and output
# ---------------------------------------------------------------------------

# Colemak first, Norwegian second, Caps Lock as Escape in both.
input type:keyboard {
    xkb_layout us,no
    xkb_variant colemak,
    xkb_options caps:escape
}
bindsym $mod+Shift+space input type:keyboard xkb_switch_layout next

input type:touchpad {
    tap enabled
}

seat * xcursor_theme Yaru 24

# Ubuntu's wallpaper, which this machine points at the company one.
output * bg /usr/share/backgrounds/warty-final-ubuntu.png fill

# ---------------------------------------------------------------------------
# What a full desktop would do
# ---------------------------------------------------------------------------

# Waybar (waybar/config.jsonc).
bar {
    swaybar_command waybar
}

# Wifi icon in the bar's tray. --indicator is the Wayland tray protocol.
exec nm-applet --indicator
# Password prompts for apps asking for admin rights, such as NetworkManager.
exec /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1

# Lock after 10 minutes, screens off after 15, and lock before a suspend.
# sway/lock adds fingerprint unlock to swaylock.
exec swayidle -w \
    timeout 600 ~/.config/sway/lock \
    timeout 900 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    lock ~/.config/sway/lock \
    before-sleep ~/.config/sway/lock

bindsym $mod+Escape exec loginctl lock-session
bindsym $mod+Shift+e exec swaynag -t warning -m 'Log out of Sway?' -B 'Yes' 'swaymsg exit'

# Vicinae in place of Raycast.
bindsym $mod+space exec vicinae toggle

# Ubuntu's Settings app, which only starts when it thinks it is in GNOME. The
# display panel needs GNOME's compositor, so it is left out.
bindsym $mod+Ctrl+c exec env XDG_CURRENT_DESKTOP=GNOME gnome-control-center
bindsym $mod+Ctrl+w exec env XDG_CURRENT_DESKTOP=GNOME gnome-control-center wifi
bindsym $mod+Ctrl+b exec env XDG_CURRENT_DESKTOP=GNOME gnome-control-center bluetooth
for_window [app_id="(?i)(gnome-control-center|org\.gnome\.Settings)"] floating enable

# Print saves an area to ~/Pictures/Screenshots, where GNOME puts them, and
# copies it. Shift+Print only copies an area, Win+Print copies the text in an
# area (OCR). The clipboard is left alone when nothing was read, such as after
# Escape.
bindsym Print exec 'd=~/Pictures/Screenshots f=$(date +%Y-%m-%d_%H-%M-%S).png && mkdir -p $d && grim -g "$(slurp)" $d/$f && wl-copy --type image/png < $d/$f'
bindsym Shift+Print exec 'grim -g "$(slurp)" - | wl-copy --type image/png'
bindsym $mod+Print exec 'f=$(mktemp) && grim -g "$(slurp)" - | tesseract stdin stdout -l eng+nor > $f; [ -s $f ] && wl-copy < $f; rm -f $f'

# Function keys. --locked keeps them working on the lock screen.
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 10%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86MonBrightnessUp exec brightnessctl set +10%
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 10%-
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous
