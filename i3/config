# Plain i3 session ("i3" on the login screen). Goes in ~/.config/i3/config.
# Check it on the machine with: i3 -C -c ~/.config/i3/config
#
# The shortcuts live in i3/flow. This file adds what a bare i3 session lacks
# and a full desktop would provide: layout, bar, launcher, tray, function keys.
# i3 only allows comments on their own line, never after a command.

# The Windows key. On an Apple keyboard, use Mod1 to stay on Option.
set $mod Mod4

# Colemak with Caps Lock as Escape for the session. i3 re-reads its bindings when the layout changes.
exec --no-startup-id setxkbmap -layout us -variant colemak -option caps:escape

font pango:FiraCode Nerd Font 10

include ~/.config/i3/flow

# Vicinae in place of Raycast.
bindsym $mod+space exec --no-startup-id vicinae toggle

# Flameshot in place of macshot, on the PC's screenshot key: Print captures
# an area to annotate, Shift+Print copies an area straight to the clipboard.
bindsym Print exec --no-startup-id flameshot gui
bindsym Shift+Print exec --no-startup-id flameshot gui --accept-on-select --clipboard
# Area to text (macshot's Capture OCR). The clipboard is left alone when
# nothing was read, such as after Escape.
bindsym $mod+Print exec --no-startup-id "f=$(mktemp) && flameshot gui --accept-on-select --raw | tesseract stdin stdout -l eng+nor > $f; [ -s $f ] && xclip -selection clipboard < $f; rm -f $f"

# Lock, and log out of i3.
bindsym $mod+Escape exec --no-startup-id loginctl lock-session
bindsym $mod+Shift+e exec i3-nagbar -t warning -m 'Log out of i3?' -B 'Yes' 'i3-msg exit'

exec --no-startup-id dex --autostart --environment i3
# i3/lock adds fingerprint unlock to i3lock.
exec --no-startup-id xss-lock --transfer-sleep-lock -- ~/.config/i3/lock
# Wifi and Bluetooth icons in the bar's tray, in place of GNOME's top bar.
exec --no-startup-id nm-applet
exec --no-startup-id blueman-applet

# GNOME handled the function keys; under i3 each one needs a command.
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +10%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 10%-
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

bar {
    status_command i3status
}
