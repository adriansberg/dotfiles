#!/bin/bash
# i3lock that also unlocks on a fingerprint. i3lock only asks PAM after Enter,
# so fprintd-verify runs alongside it and ends the locker on a match.
# xss-lock starts this; it follows /usr/share/doc/xss-lock/transfer-sleep-lock-i3lock.sh.

# xss-lock only passes a sleep lock when suspending. Open a dummy otherwise so
# the redirects below always have an fd to close.
[[ -n $XSS_SLEEP_LOCK_FD ]] || exec {XSS_SLEEP_LOCK_FD}</dev/null

kill_i3lock() {
    pkill -xu "$EUID" "$@" i3lock
}
trap kill_i3lock TERM INT

# i3lock forks once the screen is locked. Closing our copy of the sleep lock
# after that lets the suspend go ahead.
i3lock {XSS_SLEEP_LOCK_FD}<&- || exit
exec {XSS_SLEEP_LOCK_FD}<&-

(
    trap 'kill $! 2>/dev/null; exit' TERM
    while :; do
        fprintd-verify >/dev/null 2>&1 &
        if wait $!; then
            kill_i3lock
            exit
        fi
        # A wrong finger, or the reader is still waking up after a suspend.
        sleep 1
    done
) &
verifier=$!

while kill_i3lock -0; do
    sleep 0.5
done
# A password unlock leaves fprintd-verify holding the reader, which would keep
# sudo from using it.
kill "$verifier" 2>/dev/null
wait
