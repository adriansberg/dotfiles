azlog () {
  az webapp log tail --name $1 --resource-group $2
}

gbdd () {
  git branch | grep "$1" | xargs git branch -D
}

gbpa () {
  git checkout main && git fetch -p && git branch -vv | awk '/: gone]/{print $1}' | xargs git branch -D
}

findid () {
